# Copy to .env and fill in. .env is gitignored and read automatically at startup.
# A real environment variable always wins over a value in .env.

# --- extraction script (scripts/extract_incident.py) ---
# Free key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- deployment ---
# Public HTTPS address. Used for trip links and Twilio signature checks; also turns on HSTS.
PUBLIC_BASE_URL=
# Officers enter this on /dashboard to mark areas addressed. Empty = anyone can (demo only).
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(24))"
ADMIN_TOKEN=
# From the Twilio console. When set, /sms rejects requests without a valid X-Twilio-Signature.
TWILIO_AUTH_TOKEN=
# Database file. In Docker this points at the mounted volume.
RIDE_RADAR_DB=
# Seed an empty database at startup (1/0), and include the badged sample incidents (1/0).
AUTO_SEED=1
SEED_SAMPLE=1
LOG_LEVEL=INFO

# --- SOS ---
# Where SOS videos are stored (default: ./media). Sent videos are deleted after 30 days.
RIDE_RADAR_MEDIA=
# Groq Whisper model for the AI brief (uses GROQ_API_KEY above)
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
# WhatsApp Cloud API (Meta). Set all three for automatic alerts; otherwise riders tap to send.
# Template body must have {{1}} = contact name and {{2}} = alert link.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en
